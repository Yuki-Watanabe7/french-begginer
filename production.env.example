# 家庭内本番（compose.production.yml）の設定例。
#   cp production.env.example production.env
# production.env は Git 管理外（*.env）。実 IP・API キーをコミットしない。
# 開発用の .env とは共有しない。

# 入口（nginx）を公開するホスト側アドレス。
# 所有者が「信頼 LAN・認証なし HTTP」の残余リスクを受け入れるまでは 127.0.0.1 のまま使う。
# LAN 公開時は DHCP 予約した LAN IPv4 を1つ指定する（0.0.0.0 にしない。IPv6 にも公開されうる）。
FRENCH_BIND_ADDRESS=127.0.0.1

# 入口のポート。衝突したら変更し、端末で開く URL も合わせる。
FRENCH_HTTP_PORT=8080

# ブラウザで開くホスト名（ポートなし、カンマ区切り）。localhost / 127.0.0.1 は常に許可。
# 例: FRENCH_ALLOWED_HOSTS=192.168.1.20,french-host.local
FRENCH_ALLOWED_HOSTS=

# 本番専用の既存 external volume。初回以外に空 volume を作らない。
# 復元検証後だけ french-production-tutor-data-restored-<ID> へ切り替える。
FRENCH_TUTOR_VOLUME=french-production-tutor-data

# 任意。TTS・LLM 抽出・音声文字起こしに使う。設定すると LAN の端末から API 費用が発生しうる。
OPENAI_API_KEY=
