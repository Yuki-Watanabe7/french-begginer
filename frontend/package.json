{
  "name": "french-beginner-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:readonly": "tsc -b && vite build --config vite.readonly.config.ts",
    "preview:readonly": "vite preview --config vite.readonly.config.ts --host 127.0.0.1 --port 4174",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^14.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
